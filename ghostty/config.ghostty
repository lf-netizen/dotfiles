# Attach to the same persistent session as WezTerm; Herdr owns tabs and panes.
command = /opt/homebrew/bin/herdr

font-family = JetBrains Mono
font-family = MesloLGS NF
font-family = Menlo
font-family = Monaco
font-size = 14
font-feature = -calt, -clig, -liga

theme = Kanagawa Wave
cursor-style = block
cursor-style-blink = false

# Preprocessed wallpaper supplies WezTerm's saturation=0, brightness=0.5 in linear RGB.
# Mix it 50/50 with the theme background; no desktop bleed.
background-image = ~/.config/img/ghostty-background.jpeg
background-image-opacity = 0.5
background-image-position = center
background-image-fit = cover
background-opacity = 1

macos-titlebar-style = hidden
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
scrollbar = never
window-width = 80
window-height = 24
confirm-close-surface = always

# Preserve Polish Option-letter composition on both sides of the keyboard.
macos-option-as-alt = false
keybind = clear
keybind = ctrl+q=quit
keybind = ctrl+shift+v=paste_from_clipboard
# Send the exact modified-key sequences accepted by Herdr 0.9.1.
keybind = ctrl+shift+tab=csi:9;6u
keybind = ctrl+shift+o=csi:111;6u
keybind = ctrl+super+equal=increase_font_size:1
keybind = ctrl+super+minus=decrease_font_size:1
keybind = ctrl+super+0=reset_font_size
